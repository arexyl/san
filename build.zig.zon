        .libpng = .{
            .url = "https://download.sourceforge.net/libpng/libpng-1.6.59.tar.xz",
            .hash = "N-V-__8AALklYQB8O4neIy7xVIGTKkDqkIwe5uoN9ExqSXov",
            .lazy = true,
        },
        // zlib 1.3.2, the upstream release archive under zlib.net/fossils/,
