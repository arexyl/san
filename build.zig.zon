        // and the archive behind this hash matched that digest on
        // 2026-10-17. Zig keeps only a recompressed tarball, so no build
        // can repeat that check.
        .zlib = .{
            .url = "https://zlib.net/fossils/zlib-1.3.2.tar.gz",
